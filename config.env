# safeguard: configurable thresholds
# Template installed to ~/.claude/.safeguard/config.env

# Truncation thresholds
SAFEGUARD_TRUNCATE_BYTES=20480          # 20KB generic output truncation
SAFEGUARD_SUBAGENT_READ_BYTES=10240     # 10KB subagent Read truncation
SAFEGUARD_SUPPRESS_BYTES=524288         # 500KB suppress entirely
SAFEGUARD_READ_GUARD_MAX_MB=2           # Max file size for Read tool

# Smart log compression for large Bash output (build/test logs). When 1,
# oversized Bash output is compressed to its error/fail/warning/stack/summary
# lines instead of head+tail truncation (which discards errors in the middle).
# Set 0 to fall back to plain head+tail truncation.
SAFEGUARD_LOG_COMPRESS=1

# Write/Edit size limits
SAFEGUARD_WRITE_MAX_BYTES=102400        # 100KB max Write content
SAFEGUARD_EDIT_MAX_BYTES=51200          # 50KB max Edit new_string
SAFEGUARD_NOTEBOOK_MAX_BYTES=51200      # 50KB max NotebookEdit

# Subagent budgets
SAFEGUARD_DEFAULT_CALL_LIMIT=30         # Default tool calls per subagent
SAFEGUARD_DEFAULT_BYTE_LIMIT=102400     # Default cumulative output bytes per subagent

# Session budget (estimated tokens)
SAFEGUARD_BUDGET_TOTAL=280000

# Repomap (ranked repo tag map injected into SessionStart additionalContext).
# SAFEGUARD_REPOMAP_MAX_TOKENS is a chars/4 approximation; 4096 fits 3-4 files on
# typical TS/JS repos. 1024 starves real repos (see docs/repomap.md).
SAFEGUARD_REPOMAP_MAX_TOKENS=4096
SAFEGUARD_REPOMAP_MAX_FILE_BYTES=524288   # Skip source files bigger than 512 KB
SAFEGUARD_REPOMAP_MAX_TAGS_PER_FILE=40    # Cap per-file contribution (0 = unlimited)
